@page "/owner/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using resisafe.Models
@using resisafe.Data
@implements IAsyncDisposable
@inject IDbContextFactory<resisafe.Data.ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = "Owner")]

<PageTitle>Index</PageTitle>

<h1>Dashboard</h1>

@if (bookings is null)
{
    <p>Loading...</p>
}
else if (!bookings.Any())
{
    <p>No bookings avalaible yet.</p>
}
else
{
    <QuickGrid Class="table" Items="bookings.AsQueryable()">
        <PropertyColumn Property="booking => booking.Property!.Title" />
        <PropertyColumn Property="booking => booking.CheckInDate.ToShortDateString()" />
        <PropertyColumn Property="booking => booking.Slot" />
        <PropertyColumn Property="booking => booking.Status" />
        <PropertyColumn Property="booking => booking.AmountHeld" />
        <PropertyColumn Property="booking => booking.CreatedAt" />

        <TemplateColumn Context="booking">
            <a href="@($"bookings/details?id={booking.Id}")">Details</a> |
            <a href="@($"bookings/delete?id={booking.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
}



@code {
    private List<Booking>? bookings { get; set; }
    private ApplicationDbContext context = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type.EndsWith("nameidentifier"))?.Value;
        context = DbFactory.CreateDbContext();

        bookings = await context.Bookings
                .Include(b => b.Property)
                .Include(b => b.Guest)
                .Where(b => b.Property!.OwnerId == userId)
                .ToListAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
