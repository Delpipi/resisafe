@page "/bookings/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using resisafe.Models
@inject IDbContextFactory<resisafe.Data.ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Owner")]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Booking</h2>
    <hr />
    @if (booking is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Property</dt>
            <dd class="col-sm-10">@booking.Property!.Title</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Guest</dt>
            <dd class="col-sm-10">@booking.Guest!.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CheckInDate</dt>
            <dd class="col-sm-10">@booking.CheckInDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Slot</dt>
            <dd class="col-sm-10">@booking.Slot</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@booking.Status</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">AmountHeld</dt>
            <dd class="col-sm-10">@booking.AmountHeld</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedAt</dt>
            <dd class="col-sm-10">@booking.CreatedAt</dd>
        </dl>
        <EditForm method="post" Model="booking" OnValidSubmit="DeleteBooking" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(booking is null)">Delete</button> |
            <a href="/owner/dashboard">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Booking? booking;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var ownerId = authState.User.FindFirst(c => c.Type.EndsWith("nameidentifier"))?.Value;

        using var context = DbFactory.CreateDbContext();
        booking = await context.Bookings.FirstOrDefaultAsync(b => b.Id == Id && b.Property!.OwnerId == ownerId);

        if (booking is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteBooking()
    {
        using var context = DbFactory.CreateDbContext();
        context.Bookings.Remove(booking!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/bookings");
    }
}
